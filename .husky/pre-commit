#!/bin/sh

# Pre-commit hook: Secret Scan + Code Review + Documentation Generation
# Blocks on serious issues only

echo ""
echo "🔍 Pre-commit checks running..."
echo ""

# Secret scan (blocks on staged .env files or credential patterns)
sh "$(git rev-parse --show-toplevel)/scripts/secret-scan-hook.sh"
if [ $? -ne 0 ]; then
  exit 1
fi

node scripts/code-review.js
if [ $? -ne 0 ]; then
  exit 1
fi

node scripts/generate-docs.js

node scripts/validate-npm-scripts.js
if [ $? -ne 0 ]; then
  exit 1
fi

# Environment issue: If pre-commit times out (slow filesystem/antivirus),
# bypass with: git commit --no-verify
# See docs/operations/environment-optimization.md for details.

echo "✅ Pre-commit checks passed - ready to commit!"
echo ""
