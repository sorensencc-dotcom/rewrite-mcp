

echo "Running pre-commit secret scan..."

# Search for common secret patterns in staged files
# - AIza: Google API Keys
# - AKIA: AWS Access Keys
if git diff --cached --name-only | xargs grep -E "AIza[0-9A-Za-z_-]{35}|AKIA[0-9A-Z]{16}" 2>/dev/null; then
  echo "--------------------------------------------------------"
  echo "CRITICAL ERROR: Potential secret detected in staged files!"
  echo "Commit aborted to prevent credential leakage."
  echo "Please remove the secrets and try again."
  echo "--------------------------------------------------------"
  exit 1
fi

echo "Running BOB automatic build and generation..."
cd bob
node bin/bob.js build
cd ..

# Auto-stage only BOB-generated files (not all untracked files)
# BOB outputs to bob/generated/, history.jsonl, and modifies bob-owned files only
git add bob/generated/ history/history.jsonl 2>/dev/null || true

echo "🔍 Checking new skills against policy..."
# Check for new skill directories in staged files
NEW_SKILLS=$(git diff --cached --name-only 2>/dev/null | grep -E '^skills/[^/]+/(index\.js|schema\.json)$' | cut -d/ -f2 | sort | uniq)

if [ -n "$NEW_SKILLS" ]; then
  for skill in $NEW_SKILLS; do
    echo "  Evaluating skill: $skill"
    node tools/policy-agent/evaluate-skill.js check "skills/$skill"
    if [ $? -ne 0 ]; then
      echo ""
      echo "❌ Skill '$skill' failed policy evaluation."
      echo "   Options:"
      echo "   1. Fix the skill (add tests, docs, schema, remove CLI-specific code)"
      echo "   2. Request exception: npm run policy:exceptions -- add --name=$skill --approver=@you --reason='...' --review-url='...'"
      echo "   3. Move to cli-local-skills/ if truly CLI-native"
      exit 1
    fi
  done
  echo "✅ All skills passed policy evaluation."
fi

echo "Pre-commit checks passed."
exit 0
