

echo "🔍 Checking for BOB drift before pushing..."

REPO_ROOT=$(git rev-parse --show-toplevel)

# Resolve diff base: upstream push ref, fall back to origin/main, then HEAD~1
PUSH_BASE=$(git rev-parse "@{push}" 2>/dev/null \
  || git rev-parse "origin/main" 2>/dev/null \
  || git rev-parse "HEAD~1" 2>/dev/null \
  || git rev-parse "HEAD")

CHANGED=$(git diff --name-only HEAD "$PUSH_BASE" 2>/dev/null \
  | grep -cE '(docs/.*\.md|projects/.*\.md|bob/templates/|bob/core/)' || echo "0")

if [ "$CHANGED" -gt "0" ]; then
  cd "$REPO_ROOT/bob" || exit 1
  node bin/bob.js build
  cd "$REPO_ROOT" || exit 1

  if ! git diff --quiet; then
    echo "------------------------------------------------------------"
    echo "❌ DRIFT DETECTED: Push blocked."
    echo "BOB regenerated files that are not committed."
    echo "Fix: cd bob && node bin/bob.js build && cd .. && git add bob/generated/ && git commit -m '[claude] chore: BOB sync'"
    echo "------------------------------------------------------------"
    exit 1
  fi
else
  echo "⏭  No BOB-relevant changes — skipping bob build."
fi

echo "✅ Pre-push verification passed."
exit 0
