{
  "version": "pb-2026-06-05",
  "stages": [
  {
    "name": "SemanticExtractor",
    "mode": "parallel",
    "weight": 0.9
  },
  {
    "name": "RelationshipExtractor",
    "mode": "conditional",
    "requires": [
      "semantic.confidence > 0.85"
    ]
  },
  {
    "name": "TopicExtractor",
    "mode": "serial"
  }
],
  "rules": {
  "skipIf": [
    "latency.p95 > 500ms",
    "drift.accuracy < 0.6"
  ],
  "forceRun": [
    "ImageAnalyzerV2 when doc.type == image"
  ]
}
}
