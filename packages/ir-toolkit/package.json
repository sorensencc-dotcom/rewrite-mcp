{
  "name": "@rewrite-labs/ir-toolkit",
  "version": "0.1.0",
  "description": "Rewrite Labs IR Toolkit — extraction, audit, accessibility, redesign, lead scoring, preview, pricing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./lead-scorer": {
      "types": "./dist/lead-scorer/index.d.ts",
      "import": "./dist/lead-scorer/index.js"
    },
    "./preview-generator": {
      "types": "./dist/preview-generator/index.d.ts",
      "import": "./dist/preview-generator/index.js"
    },
    "./pricing-engine": {
      "types": "./dist/pricing-engine/index.d.ts",
      "import": "./dist/pricing-engine/index.js"
    },
    "./validators": {
      "types": "./dist/validators/index.d.ts",
      "import": "./dist/validators/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "rewrite-labs",
    "ir-toolkit",
    "lead-scoring",
    "website-audit",
    "design-system"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  }
}
