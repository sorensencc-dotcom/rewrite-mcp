{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cic.example.com/schema/lineage/0.7.0",
  "type": "object",
  "title": "CIC Phase 0.7 Lineage Packet",
  "description": "Artifact lineage and provenance packet for Phase 0.7 builds",
  "required": ["artifact_id", "agent_id", "version", "build_id", "inputs", "outputs", "provenance"],
  "properties": {
    "artifact_id": {
      "type": "string",
      "description": "Unique artifact identifier (e.g., labs.redesign.gpu:0.7.0-20260609-01)",
      "pattern": "^[a-z]+\\.[a-z0-9\\-]+:[0-9]+\\.[0-9]+\\.[0-9]+-[0-9]{8}-[0-9]{2}$"
    },
    "agent_id": {
      "type": "string",
      "description": "CIC agent identifier",
      "enum": [
        "cic.ingestion",
        "cic.evolution",
        "labs.discovery",
        "labs.extractor",
        "labs.redesign.gpu",
        "labs.outreach",
        "inference.nemotron"
      ]
    },
    "version": {
      "type": "string",
      "description": "Semantic version",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "build_id": {
      "type": "string",
      "description": "Unique build identifier",
      "pattern": "^build-[0-9]{8}-[0-9]{6}$"
    },
    "phase": {
      "type": "string",
      "enum": ["0.7"],
      "description": "Phase identifier"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Parent artifact IDs this build depends on",
      "default": []
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Output artifact IDs produced by this build",
      "default": []
    },
    "provenance": {
      "type": "object",
      "description": "Build provenance and source information",
      "required": ["git_sha", "timestamp", "sbom_ref"],
      "properties": {
        "git_sha": {
          "type": "string",
          "description": "Git commit SHA",
          "pattern": "^[a-f0-9]{40}$"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Build timestamp (ISO 8601)"
        },
        "sbom_ref": {
          "type": "string",
          "description": "Reference to SBOM artifact"
        },
        "builder": {
          "type": "string",
          "description": "Build system identifier"
        }
      }
    },
    "drift_signature": {
      "type": "string",
      "description": "SHA256 hash of build environment state",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "parent_build_id": {
      "type": "string",
      "description": "Previous build ID (for ancestry tracking)",
      "pattern": "^build-[0-9]{8}-[0-9]{6}$"
    }
  }
}
