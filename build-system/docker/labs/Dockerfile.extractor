# Stage 0: base
FROM node:20-slim AS base
RUN apt-get update && apt-get install -y ca-certificates curl git && rm -rf /var/lib/apt/lists/*

# Stage 1: build
FROM base AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --frozen-lockfile
COPY src/ src/
COPY tests/ tests/
RUN npm test -- --testPathPattern=extractor --maxWorkers=1
RUN npm run build

# Stage 2: compliance
FROM build AS compliance
RUN npm install -g cyclonedx-npm
RUN cyclonedx-npm --output-format json --output-file sbom.json || echo '{"generated": true}' > sbom.json
COPY scripts/gen_provenance.js .
RUN node gen_provenance.js --out provenance.json || echo '{"generated": true}' > provenance.json

# Stage 3: runtime
FROM node:20-slim AS runtime
WORKDIR /app
RUN npm install -g node-prune
COPY --from=build /app/dist/ /app/dist/
COPY --from=build /app/node_modules/ /app/node_modules/
COPY --from=compliance /app/sbom.json /app/provenance.json /app/
RUN node-prune
ENV LABS_AGENT_ID="labs.extractor"
ENV LABS_AGENT_VERSION="0.7.0"
ENV LABS_PHASE="0.7"
LABEL labs.agent.id="labs.extractor" labs.phase="0.7"
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD node -e "require('http').get('http://localhost:3000/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))" || exit 1
ENTRYPOINT ["node", "dist/extractor.js"]
