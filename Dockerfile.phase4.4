FROM node:24-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install --quiet

# Copy Phase 4.4 artifacts
COPY projects/rewrite-labs/harvester ./projects/rewrite-labs/harvester
COPY projects/cic/bridge ./projects/cic/bridge
COPY tools/repomix ./tools/repomix
COPY sample-repomix-output.json ./
COPY *.js ./

# Compile TypeScript
RUN npm run build || true

# Install Repomix CLI
RUN npm install -g repomix --quiet

# Set environment
ENV NODE_ENV=production
ENV CODEBURN_ENDPOINT=${CODEBURN_ENDPOINT:-http://localhost:3000/metrics}
ENV OPERATOR_ID=${OPERATOR_ID:-docker-operator}

# Expose metrics port
EXPOSE 3001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3001/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))"

# Default command
CMD ["node", "/app/telemetry-service.js"]
