{
  "name": "rewrite-mcp-monorepo",
  "version": "2.29.3",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "projects/*",
    "tools/*",
    "packages/*"
  ],
  "description": "Rewrite Labs Monorepo — Antigravity 2.0 Hardened",
  "scripts": {
    "sync-docs": "bash scripts/sync-docs.sh",
    "load-tokens": "node apps/operator-ui/scripts/loadTokens.js",
    "validate-design": "node apps/operator-ui/scripts/validateDesign.js",
    "cic-ui:repair": "bash tools/cic-ui/repair-ui-layer.sh",
    "cic-ui:validate": "node tools/cic-ui/integrity-validator.js",
    "cic-ui:smoke": "node tools/cic-ui/smoke-tests.js",
    "cic-ui:sentinel": "node tools/cic-ui/drift-sentinel.js",
    "cic-ui:snapshot": "node tools/cic-ui/golden-master.js",
    "cic-ui:telemetry": "node tools/cic-ui/telemetry-hooks.js",
    "build-docs": "bash scripts/sync-docs.sh --build && npm run test:links",
    "test-orchestrator": "cd projects/cic/orchestrator && npm test",
    "test:links": "cd .. && bash tools/regressions/check-links.sh",
    "stress-test": "cd ../tools/runtime-harness && npm run stress",
    "gh-actions:upgrade": "node ../scripts/gh-actions-upgrade.js",
    "gh-actions:check": "node ../tools/operator-actions-compliance.js --scan --report",
    "gh-actions:fix": "node ../tools/operator-actions-compliance.js --fix --report",
    "gh-actions:check-manifest": "tsx ../scripts/gh-actions-check.ts",
    "gh-actions:fix-manifest": "tsx ../scripts/gh-actions-fix.ts",
    "test:gh-actions": "vitest run tests/gh-actions-upgrade.test.ts",
    "release:notes": "node tools/release-notes.mjs",
    "release:diff": "node tools/release-diff.mjs",
    "release:timeline": "node tools/release-timeline.mjs",
    "release:tag": "node tools/release-tag.mjs",
    "release:bundle": "node tools/release-bundle.mjs",
    "release:full": "npm run doc:drift && npm run build-docs && npm run release:notes && npm run release:diff && npm run release:timeline && npm run release:tag && npm run release:bundle",
    "doc:version": "node scripts/docVersion.js",
    "doc:drift": "node tools/doc-drift-check.js",
    "policy:check": "node tools/policy-agent/evaluate-skill.js check",
    "policy:report": "node tools/policy-agent/evaluate-skill.js report",
    "policy:exceptions": "node tools/policy-agent/evaluate-skill.js exceptions",
    "policy:audit": "node tools/policy-agent/evaluate-skill.js audit",
    "prepare": "husky",
    "bench:capture": "node benchmarks/capture/capture.js",
    "bench:metadata": "npx ts-node benchmarks/tools/extractMetadata.ts",
    "bench:opus-sonnet": "npx ts-node benchmarks/tools/opusSonnetBenchmark.ts",
    "bench:render": "npx ts-node benchmarks/tools/renderBenchmark.ts",
    "bench:stc": "npx ts-node benchmarks/tools/screenshotToCodeHarness.ts",
    "bench:status": "npx ts-node tests/utils/generateStatus.ts",
    "bench:all": "npm run bench:capture && npm run bench:metadata && npm run bench:opus-sonnet",
    "test:rewrite": "npx ts-node tests/rewrite/runRewriteTests.ts",
    "test:render": "npx ts-node tests/render/runRenderTests.ts",
    "test:stc": "npx ts-node tests/stc/runStcTests.ts",
    "test:metadata": "npx ts-node tests/metadata/runMetadataTests.ts",
    "test:rewrite-labs": "npx ts-node tests/runAll.ts",
    "cost:reports": "npx ts-node -e \"import('./benchmarks/costs/reports/generate.ts').then(m => m.generateAllReports())\"",
    "cost:helm": "npx ts-node -e \"import('./benchmarks/costs/reports/helm.ts').then(m => m.writeHelmDashboardReport())\"",
    "cic:evolution-loop": "npx tsx projects/cic/evolution/src/loopRunner.ts",
    "cic:evolution-challenge": "npx tsx projects/cic/evolution/src/challengeRunner.ts",
    "cic:amb-run": "npx tsx projects/cic/evolution/src/amb/ambRunner.ts",
    "arl:build:7.12": "npx tsc projects/cic/ingestion/src/reasoning/arl/engine/ThresholdModel.ts --skipLibCheck",
    "arl:build:7.13": "npx tsc projects/cic/ingestion/src/reasoning/arl/engine/GovernanceHookExecutor.ts --skipLibCheck",
    "arl:build:7.14": "npx tsc projects/cic/ingestion/src/reasoning/arl/engine/SelfDiagnosticsEngine.ts --skipLibCheck",
    "test:arl": "vitest run projects/cic/ingestion/src/reasoning/arl/tests/",
    "ci": "npm run bench:metadata && npm run test:rewrite-labs"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "husky": "^9.0.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cheerio": "^1.2.0",
    "dotenv": "^16.3.1",
    "esbuild": "^0.28.0",
    "googleapis": "^173.0.0",
    "puppeteer": "^25.1.0",
    "vite": "^8.0.16",
    "yaml": "^2.9.0",
    "zod": "^3.22.4"
  }
}
