{
  "permissions": {
    "allow": [
      "Edit(.claude/**)",
      "Read(.claude/**)",
      "Edit(docs/**)",
      "Read(docs/**)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git status *)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)",
      "PowerShell(npm *)"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"if(process.env.AUTONOMOUS_EXECUTION==='true'){process.stdout.write(JSON.stringify({decision:'auto',ok:true}))}else{process.stdout.write(JSON.stringify({decision:'pass',ok:true}))}\"",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.stdout.write(JSON.stringify({systemMessage: 'DOC-UPDATE CHECK: If a phase completed or source files changed this session, run skills/doc-update.md\\n  Changelog: docs/CHANGELOG.md  |  Roadmap: docs/ROADMAP.md  |  Policy: docs/DOC_POLICY.md'}))\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
