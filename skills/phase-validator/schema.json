{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Phase Validator Input Schema",
  "type": "object",
  "properties": {
    "phaseId": { "type": "string" },
    "artifacts": { "type": "array", "items": { "type": "object", "properties": { "type": { "type": "string", "enum": ["schema", "implementation", "test", "documentation"] }, "path": { "type": "string" }, "content": { "type": "string" } }, "required": ["type", "path"] }, "minItems": 1, "maxItems": 100 },
    "validationMode": { "type": "string", "enum": ["basic", "strict", "comprehensive"], "default": "strict" },
    "checkSchema": { "type": "boolean", "default": true },
    "checkTests": { "type": "boolean", "default": true },
    "checkPolicy": { "type": "boolean", "default": true },
    "minTestCoverage": { "type": "integer", "default": 80 },
    "minPolicyScore": { "type": "number", "default": 0.75 }
  },
  "required": ["phaseId", "artifacts"]
}
