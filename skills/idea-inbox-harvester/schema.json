{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Idea Inbox Harvester Input Schema",
  "description": "Input validation for harvesting and storing ideas from MEE findings",
  "type": "object",
  "properties": {
    "findings": { "type": "array", "items": { "type": "object" }, "minItems": 0, "maxItems": 100 },
    "context": { "type": "object", "properties": { "source": { "type": "string" }, "tags": { "type": "array", "items": { "type": "string" } } } },
    "deduplicateMode": { "type": "string", "enum": ["off", "exact", "semantic"], "default": "semantic" },
    "priorityThreshold": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.6 },
    "storeInCKG": { "type": "boolean", "default": true },
    "generateDashboard": { "type": "boolean", "default": false }
  },
  "required": ["findings"]
}
