{
  "agent_id": "cic-foreman-wil-v1",
  "name": "CIC Foreman",
  "version": "1.0.0",
  "description": "CIC Meta-Evolution Engine integrated with Wayland as a first-class agent",
  "endpoints": {
    "http": "http://127.0.0.1:3035",
    "events": "http://127.0.0.1:3035/events",
    "health": "http://127.0.0.1:3035/health"
  },
  "capabilities": {
    "phase_execution": {
      "executor": "mee-phase-executor",
      "supports_checkpointing": true,
      "supports_resumption": true,
      "max_phases": 7,
      "phases": [
        "45.1-phase-executor",
        "45.2-benchmark-runner",
        "45.3-environment-validator",
        "45.4-finding-assessor",
        "45.5-helm-daily-brief",
        "45.6-idea-inbox-harvester",
        "45.7-phase-validator"
      ]
    },
    "tools": {
      "shell": {
        "adapter": "ShellToolAdapter",
        "constraints": ["non-interactive", "workspace-scoped"],
        "forbidden_flags": ["-i", "--interactive"],
        "timeout_ms": 30000
      },
      "file": {
        "adapter": "FileToolAdapter",
        "operations": ["read", "write", "delete"],
        "workspace_root": "/cic_workspace",
        "max_file_size_mb": 25,
        "allowed_extensions": ["*"]
      },
      "model": {
        "adapter": "ModelToolAdapter",
        "key_delegation": "wayland",
        "supported_models": ["claude-opus", "claude-sonnet", "claude-haiku"],
        "timeout_ms": 60000
      },
      "http": {
        "adapter": "HttpToolAdapter",
        "methods": ["GET", "POST", "PUT", "DELETE", "PATCH"],
        "credential_validation": "strict",
        "timeout_ms": 30000
      }
    }
  },
  "routes": {
    "task_submission": {
      "method": "POST",
      "path": "/task",
      "description": "Submit new CIC phase execution task",
      "input_schema": {
        "type": "object",
        "properties": {
          "phase": { "type": "string" },
          "config": { "type": "object" },
          "metadata": { "type": "object" }
        },
        "required": ["phase"]
      }
    },
    "task_status": {
      "method": "GET",
      "path": "/status/:id",
      "description": "Retrieve task status and progress"
    },
    "artifact_retrieval": {
      "method": "GET",
      "path": "/artifact/:task_id/:artifact_id",
      "description": "Fetch artifact metadata and content references",
      "max_size_mb": 25
    },
    "health_check": {
      "method": "GET",
      "path": "/health",
      "description": "Service health and task statistics"
    },
    "events_stream": {
      "method": "GET",
      "path": "/events",
      "description": "Server-sent events stream for task progress",
      "event_types": [
        "task.created",
        "task.started",
        "task.progress",
        "task.completed",
        "task.failed",
        "tool.call",
        "governance.decision"
      ]
    }
  },
  "security": {
    "sandbox": {
      "enabled": true,
      "root_path": "/cic_workspace",
      "enforcement": "strict"
    },
    "authentication": {
      "method": "wayland-delegation",
      "key_management": "wayland-kmgr",
      "local_keys_allowed": false,
      "credential_sources": [
        "wayland-kmgr-api-keys",
        "wayland-kmgr-oauth",
        "wayland-kmgr-service-account"
      ]
    },
    "authorization": {
      "policy_engine": "wayland-rbac",
      "role_based": true,
      "tool_permissions": {
        "shell": ["basic", "advanced"],
        "file": ["read", "write", "delete"],
        "model": ["call"],
        "http": ["request"]
      }
    },
    "audit": {
      "enabled": true,
      "log_level": "info",
      "correlation_id": "all",
      "retention_days": 90
    }
  },
  "observability": {
    "logging": {
      "format": "json",
      "fields": [
        "timestamp",
        "level",
        "correlationId",
        "event",
        "taskId",
        "phase",
        "duration_ms"
      ]
    },
    "metrics": {
      "enabled": true,
      "collectors": [
        "task_count",
        "task_duration",
        "tool_call_count",
        "error_rate",
        "artifact_size"
      ],
      "export_endpoint": "http://127.0.0.1:3035/metrics"
    },
    "tracing": {
      "enabled": true,
      "correlation_id_propagation": true,
      "trace_export": "jaeger",
      "jaeger_endpoint": "http://127.0.0.1:6831"
    },
    "health_signals": {
      "uptime": true,
      "task_queue_depth": true,
      "error_count": true,
      "last_task_timestamp": true
    }
  },
  "integration": {
    "wayland_registry": {
      "enabled": true,
      "heartbeat_interval_ms": 30000,
      "registration_ttl_seconds": 300
    },
    "session_mapping": {
      "enabled": true,
      "pipeline_events_to_ui": true,
      "governance_events_to_ui": true
    },
    "artifact_paths": {
      "base": "/cic_workspace/artifacts",
      "metadata_endpoint": "/artifact/:task_id/:artifact_id"
    }
  },
  "constraints": {
    "artifact_size_limit_mb": 25,
    "task_timeout_minutes": 60,
    "max_concurrent_tasks": 10,
    "max_tool_calls_per_task": 1000
  },
  "metadata": {
    "created_at": "2026-06-07T00:00:00Z",
    "last_updated_at": "2026-06-07T00:00:00Z",
    "phase": "46",
    "status": "active",
    "maintainer": "CIC Development Team",
    "support_url": "https://github.com/anthropics/cic"
  }
}
