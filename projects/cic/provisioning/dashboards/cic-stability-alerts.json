    {
      "uid": "drift-metric-stall",
      "title": "CIC Stability — Drift Metric Stalled",
      "condition": "B",
      "data": [
        {
          "refId": "A",
          "queryType": "",
          "model": {
            "expr": "increase(cic_stability_drift_avg[5m])",
            "interval": "",
            "legendFormat": "Drift Avg"
          },
          "datasourceUid": "prometheus",
          "relativeTimeRange": {
            "from": 300,
            "to": 0
          }
        },
        {
          "refId": "B",
          "queryType": "",
          "model": {
            "conditions": [
              {
                "evaluator": {
                  "params": [0],
                  "type": "lt"
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": ["A"]
                },
                "type": "query"
              }
            ],
            "datasourceUid": "-100",
            "expression": "A",
            "hide": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200,
            "reducer": "avg",
            "type": "threshold"
          },
          "datasourceUid": "-100",
          "expression": "A",
          "hide": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200,
          "reducer": "avg",
          "type": "threshold"
        }
      ],
      "noDataState": "Alerting",
      "execErrState": "Alerting",
      "for": "5m",
      "annotations": {
        "description": "Drift Avg metric has not changed in 5 minutes. The stability soak runner may have crashed or become unresponsive.",
        "runbook_url": "https://wiki.internal/cic/stability-soak-runbook#drift-stall"
      },
      "labels": {
        "phase": "7.15-7.20",
        "severity": "critical"
