# CIC Context Service Environment Configuration
# Copy to .env and fill in actual values

# Server
CONTEXT_API_PORT=8080
CONTEXT_API_HOST=0.0.0.0
CONTEXT_API_VERSION=1.0.0

# Backend Services
CRG_BASE_URL=http://localhost:8081
CRG_TIMEOUT=30000

CIC_BASE_URL=http://localhost:8082
CIC_TIMEOUT=30000

# Caching
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_MAX_SIZE=10000

# Timeouts (milliseconds)
REQUEST_TIMEOUT=30000
SLICE_TIMEOUT=10000
QUERY_TIMEOUT=60000

# Ruflo Orchestration
RUFLO_MAX_CONCURRENCY=10
RUFLO_DEFAULT_TIMEOUT=30000
RUFLO_REGISTRY_CACHE_ENABLED=true

# Observability
TRACING_ENABLED=true
TRACING_SAMPLE_RATE=1.0

METRICS_ENABLED=true
METRICS_INTERVAL=60000

HEALTH_CHECK_INTERVAL=30000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Node
NODE_ENV=development
