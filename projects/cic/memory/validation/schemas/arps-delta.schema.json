{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["change_type", "old_value", "new_value", "git_commit", "confidence", "affected_subsystems"],
  "properties": {
    "change_type": {
      "type": "string",
      "enum": ["phase_completion", "phase_creation", "prompt_rewrite", "instruction_update", "priority_adjustment"]
    },
    "phase_id": {
      "type": "string"
    },
    "old_value": {
      "type": "string"
    },
    "new_value": {
      "type": "string"
    },
    "git_commit": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "affected_subsystems": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
