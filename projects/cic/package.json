{
  "name": "cic",
  "version": "1.0.0",
  "description": "Cast Iron Charlie documentary pipeline system",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/context-service/index.js",
    "dev": "node dist/context-service/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run test/integration",
    "test:feedback-loop": "vitest run test/integration/token-economy-feedback-loop.test.ts",
    "test:scheduler": "vitest run test/integration/scheduler.test.ts",
    "test:first-flow": "node --loader ts-node/esm scripts/test-first-flow.ts",
    "test:mcp-integration": "node --loader ts-node/esm tests/integration.test.ts",
    "phase-d:zero-run": "node --loader ts-node/esm scripts/phase-d-zero-run.ts"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.6",
    "ts-node": "^10.9.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^25.0.0",
    "@types/node-cron": "^3.0.9",
    "@types/uuid": "^10.0.0",
    "express": "^4.22.2",
    "node-cron": "^3.0.3",
    "uuid": "^14.0.0",
    "yaml": "^2.9.0"
  }
}
