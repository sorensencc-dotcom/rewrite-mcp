{
  "name": "cic-ingestion",
  "version": "1.0.0",
  "description": "Cast Iron Charlie ingestion pipeline with LLM token/context synergy controller",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc 2>/dev/null || true",
    "start": "node src/server/intelligence-server.js",
    "ingest": "node src/pipeline/run-pipeline.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "orchestrate:stability": "node src/stability/orchestrator.js",
    "test:stability": "vitest run --reporter=verbose",
    "queue:clear": "node scripts/clear-queues.js",
    "dlq:clear": "node scripts/clear-dlq.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/generative-ai": "^0.24.1",
    "@qdrant/js-client-rest": "^1.9.0",
    "dotenv": "^17.4.2",
    "googleapis": "^173.0.0",
    "moment": "^2.30.1",
    "openai": "^4.52.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "vitest": "^4.1.6"
  }
}
