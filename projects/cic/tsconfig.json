{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2020",
    "module": "ES2020",
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "."
  },
  "ts-node": {
    "esm": true,
    "experimentalEsm": true,
    "moduleResolution": "node",
    "transpileOnly": true
  },
  "include": [
    "src/**/*.ts",
    "context-service/**/*.ts",
    "context-api/**/*.ts",
    "crg-adapter/**/*.ts",
    "observability/**/*.ts",
    "config/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "ingestion", "tests", "**/*.test.ts", "data", "src/cic/**", "src/mee/**", "ruflo-orchestration/**/*.d.ts"]
}
