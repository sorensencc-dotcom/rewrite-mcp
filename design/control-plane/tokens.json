{
  "_meta": {
    "file": "design/control-plane/tokens.json",
    "version": "1.0.0",
    "date": "2026-05-15",
    "description": "Single source of truth for control-plane UI theming. Referenced by operator-ui/css/control-room.css."
  },
  "colors": {
    "bg":             "#0a0a0f",
    "surface":        "#13131a",
    "surfaceRaised":  "#1c1c26",
    "surfaceBorder":  "#23233a",
    "accent":         "#4f8ef7",
    "accentMuted":    "#1e3a6e",
    "danger":         "#e05252",
    "dangerMuted":    "#3d1818",
    "success":        "#3dba6b",
    "successMuted":   "#12391e",
    "warning":        "#e0a033",
    "warningMuted":   "#3d2e0a",
    "textPrimary":    "#e8e8f0",
    "textSecondary":  "#8888a8",
    "textMuted":      "#555568"
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "40px"
  },
  "typography": {
    "heading": {
      "family": "'Inter', 'system-ui', sans-serif",
      "weight": "600",
      "sizeLg": "16px",
      "sizeMd": "14px",
      "sizeSm": "12px"
    },
    "body": {
      "family": "'Inter', 'system-ui', sans-serif",
      "weight": "400",
      "size": "13px",
      "lineHeight": "1.5"
    },
    "mono": {
      "family": "'JetBrains Mono', 'Fira Mono', 'Consolas', monospace",
      "size": "12px",
      "lineHeight": "1.6"
    }
  },
  "radii": {
    "sm": "4px",
    "md": "8px"
  },
  "elevation": {
    "none":  "none",
    "low":   "0 1px 3px rgba(0,0,0,0.4)",
    "mid":   "0 4px 12px rgba(0,0,0,0.6)"
  },
  "transition": {
    "fast": "120ms ease",
    "base": "200ms ease"
  }
}
