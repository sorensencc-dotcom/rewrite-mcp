# ============================================================
# Phase 18 Environment Configuration Template
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ── LLM ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional LLM overrides
LLM_MODEL=claude-sonnet-4-6
LLM_HARD_TOKEN_LIMIT=16384
LLM_CACHE_THRESHOLD=0.92

# ── Qdrant ──────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=cic_context
# QDRANT_API_KEY=              # required for Qdrant Cloud

# ── CIC Intelligence Server ──────────────────────────────────
PORT=4000                        # intelligence-server.js port
INTELLIGENCE_TOKEN=              # optional shared secret (control-plane ↔ intelligence)

# ── Control Plane ────────────────────────────────────────────
# PORT=3000                      # control-plane port (set differently per process)
CIC_INTELLIGENCE_URL=http://localhost:4000

# ── Google Auth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=XXXX.apps.googleusercontent.com
ALLOWED_EMAILS=sorensencc@gmail.com  # comma-separated operator emails
# AUTH_DISABLED=true             # LOCAL DEV ONLY — NEVER in production

# ── Google Drive Source ──────────────────────────────────────
GOOGLE_DRIVE_TOKEN=              # OAuth2 access token (Drive read scope)
GOOGLE_DRIVE_ROOT_ID=            # optional: restrict to specific Drive folder
DRIVE_SOURCE_USER_ID=cic-drive
DRIVE_SOURCE_INTENT=research

# ── Postiz ──────────────────────────────────────────────────
POSTIZ_API_KEY=
POSTIZ_API_URL=https://app.postiz.com/api

# ── Local LLaMA (optional) ───────────────────────────────────
LLAMA_URL=http://localhost:8080
# Set LLM_MODEL=local-llama to activate llamaClient adapter

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info   # debug | info | warn | error
